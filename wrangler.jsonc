{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unwrapped",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Pages on the old workers.dev address go through the worker so it can 301 them to SITE_URL.
    "run_worker_first": true
  },
  // The custom domain (Cloudflare creates the DNS records and certificate).
  // Keep the old workers.dev address alive: it 301-redirects pages to SITE_URL.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "myunwrapped.com", "custom_domain": true },
    { "pattern": "www.myunwrapped.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unwrapped",
      // Paste the database_id printed by `npm run db:create` here.
      "database_id": "cfa4e657-3f8f-4bbb-a6d6-96d1c3001977"
    }
  ],
  // Workers AI for the support help bot (src/support.js). Free daily allowance; without it the bot hands off to the contact form.
  "ai": { "binding": "AI" },
  "triggers": {
    // Every minute: watch the TRON wallet + housekeeping. 09:00 UTC: renewal e-mails.
    "crons": ["* * * * *", "0 9 * * *"]
  },
  "vars": {
    "SITE_URL": "https://myunwrapped.com",
    "BRAND": "Unwrapped",
    // Your own USDT (TRC20) receiving address. Leave empty to disable direct USDT.
    "TRON_ADDRESS": "TSEJswyoKTWcRp5x1JFffYr8owDEtXiBA6",
    // Card payments via Lemon Squeezy are on once these four secrets are set
    // (wrangler secret put …): LEMONSQUEEZY_API_KEY, LEMONSQUEEZY_STORE_ID,
    // LEMONSQUEEZY_VARIANT_ID (a "pay what you want" variant), LEMONSQUEEZY_WEBHOOK_SECRET.
    // Webhook URL: https://myunwrapped.com/api/webhook/lemonsqueezy, event order_created.
    // Card payments via Creem are on once these three secrets are set (steps: CREEM-FA.md):
    // CREEM_API_KEY, CREEM_PRODUCT_ID (a one-time USD product), CREEM_WEBHOOK_SECRET.
    // Webhook URL: https://myunwrapped.com/api/webhook/creem, event checkout.completed.
    // Owner's own card payment link (https://wise.com/... or paypal.me/...), confirmed by hand
    // in /admin/ or by replying "paid" in Telegram. Shown only while Lemon Squeezy is off.
    "MANUAL_PAY_URL": "",
    "SUPPORT_CONTACT": "Email: support@myunwrapped.com · Telegram: @socialstore_support · WhatsApp: +447352488046 · Discord: Socialstore_pro",
    // Optional e-mail sender for license + renewal e-mails (needs RESEND_API_KEY secret).
    "EMAIL_FROM": "Unwrapped <license@myunwrapped.com>"
  },
  "observability": {
    "enabled": true
  }
}
