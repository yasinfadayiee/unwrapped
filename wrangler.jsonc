{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unwrapped",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unwrapped",
      // Paste the database_id printed by `npm run db:create` here.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "triggers": {
    // Every minute: watch the TRON wallet + housekeeping. 09:00 UTC: renewal e-mails.
    "crons": ["* * * * *", "0 9 * * *"]
  },
  "vars": {
    "SITE_URL": "https://your-domain.com",
    "BRAND": "Unwrapped",
    // Your own USDT (TRC20) receiving address. Leave empty to disable direct USDT.
    "TRON_ADDRESS": "",
    "SUPPORT_CONTACT": "",
    // Optional e-mail sender for license + renewal e-mails (needs RESEND_API_KEY secret).
    "EMAIL_FROM": ""
  },
  "observability": {
    "enabled": true
  }
}
